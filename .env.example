# Copy to .env.local and fill in. Everything is optional except where noted;
# the site works without them and hides the features they power.

# Your public site address, used for SEO links and social previews.
NEXT_PUBLIC_SITE_URL=https://aeropod.in

# WhatsApp number with country code, digits only. Powers support links,
# review collection and payment-proof messages.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_SUPPORT_EMAIL=

# UPI ID that receives payments. Leave empty to offer cash on delivery only.
# A merchant/business UPI ID (PhonePe Business, Paytm for Business, BharatPe)
# works more reliably with payment links than a personal one.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME=Aero pod

# Required to open the order dashboard at /admin. Use a long, unique password.
ADMIN_PASSWORD=

# Where orders are saved. Defaults to ./data. Must be a persistent disk.
ORDERS_DIR=

# Optional: every new order is also POSTed here as JSON (Google Apps Script
# web app that appends to a Sheet, Zapier, Make, etc.).
ORDER_WEBHOOK_URL=

# Optional ad tracking. Leave empty until you run ads.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
